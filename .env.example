# Which LLM backend to use:
#   chain | gemini | zai | anthropic | openai | groq | local | mock
#
# `chain` is the default and the one to leave alone: it tries the models in
# LLM_CHAIN in order and ends on the local Ollama one, which needs no key and
# no network — so a spent free tier or a geo-blocked endpoint slows the app
# down instead of taking it offline. `mock` is an offline rule-based stand-in
# (no key at all) that still walks every screen and the whole pipeline.
LLM_PROVIDER=chain
LLM_MODEL=auto
# Tried left to right; the last one should always be a local model.
#   · Gemini Flash is fast and free, but the free tier is a DAILY cap
#     (20 requests per model per project) rather than a per-minute one — once
#     it is spent the chain simply moves on, and a failed link is parked for
#     LLM_CHAIN_COOLDOWN_S so a seven-step pipeline does not pay for the same
#     429 seven times.
#   · GLM 4.5 Flash (z.ai) has a far more generous free tier and supports the
#     JSON mode that intent routing and extraction depend on.
LLM_CHAIN=gemini::gemini-3.7-flash,zai::glm-4.5-flash,local::qwen2.5:7b
LLM_CHAIN_COOLDOWN_S=120
# Minimum seconds between two calls to the same endpoint. Free tiers answer a
# burst with 429 rather than queueing, and the pipeline fires the router, the
# extractor and the answer back to back.
LLM_MIN_INTERVAL_S=1
# The router (intent classification) is a tiny call — the chain covers it too.
ROUTER_MODEL=chain::auto

# --- Gemini (Google's OpenAI-compatible layer) --------------------------
# From https://aistudio.google.com/apikey. The same key also serves the Gemini
# Live speech-to-text that scripts/live.sh uses, so define it once here.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.7-flash

# --- z.ai (Zhipu GLM) ---------------------------------------------------
# From https://z.ai → API keys. `thinking` is z.ai's own switch, and it is off
# here: a routing call that emits six words of JSON does not need it, and
# leaving it on roughly doubles the latency.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.5-flash
ZAI_THINKING=disabled

# From https://console.anthropic.com → API keys. Needs prepaid API credits:
# a claude.ai Pro/Max subscription does NOT cover API calls.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: point the openai provider at any OpenAI-compatible endpoint.
# e.g. Groq (free): https://api.groq.com/openai/v1  with OPENAI_API_KEY=gsk_...
# Leave unset to use api.openai.com.
# OPENAI_BASE_URL=

# Only used when LLM_PROVIDER=local (Ollama-compatible endpoint)
LOCAL_LLM_URL=http://localhost:11434

# --- API server ---------------------------------------------------------
# Shared bearer token required on /ask, /search, /ingest, /documents.
# Leave unset to run open (localhost / private network only). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
API_TOKEN=

# Comma-separated browser origins allowed to call the API. "*" allows any
# origin and is safe because every mutating route is token-gated.
CORS_ORIGINS=*

# --- Database ----------------------------------------------------------
# "embedded" (default) boots a project-local PostgreSQL via the `pgserver`
# package into ./.pgdata — no system Postgres / Docker / root needed.
# Set a real postgresql+asyncpg:// URL to use an external database instead.
DATABASE_URL=embedded

# Local embedding model (fastembed). If you change this, also set
# EMBEDDING_DIM to the new model's dimension and re-run ingestion.
# Default is multilingual (Farsi/Persian etc.); for English-only you can use
# BAAI/bge-small-en-v1.5 (384-dim, smaller/faster).
# Offline default (no download; Hugging Face is unreachable from many networks):
# hashed character n-grams. Lexical quality; the FTS half of hybrid retrieval
# carries meaning-free matches. When a real model is reachable, switch to
#   EMBEDDING_MODEL=intfloat/multilingual-e5-large  EMBEDDING_DIM=1024  EMBEDDING_PREFIXES=1
# and run  python -m scripts.reembed
EMBEDDING_MODEL=hash://384
EMBEDDING_DIM=384
EMBEDDING_PREFIXES=0
# Cross-encoder reranker also downloads from Hugging Face — off by default here.
RERANK=0

# --- Entry pipeline (app/rag/workflow.py) -----------------------------
# Fast model for intent routing. Groq is often geo-blocked, so pin a local
# one; a 7B model routes archive-vs-query text reliably, a 3B often does not.
# ROUTER_MODEL=local::qwen2.5:7b
# Wall-clock budget (seconds) for the "similar" step's model tool-loop trail.
# 0 = skip it entirely (the deterministic search is unaffected). ~45 to watch
# the agent try its own search angles.
SIMILAR_TOOL_BUDGET_S=0
# 1 = spend an extra model call on smarter label proposals (~10-25s on a
# local model). Default: keyword match against the taxonomy, no call.
LABELS_LLM=0
