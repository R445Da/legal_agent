# Which LLM backend to use: anthropic | openai | groq | local | mock
#   anthropic + claude-haiku-4-5 is the demo default: cheapest Claude, strong
#   Persian, JSON mode for routing/extraction. `mock` is an offline rule-based
#   stand-in (no key) that lets every screen and the whole pipeline run.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
# The router (intent classification) is a tiny call — pin it to the same cheap model.
ROUTER_MODEL=anthropic::claude-haiku-4-5

# From https://console.anthropic.com → API keys. Needs prepaid API credits:
# a claude.ai Pro/Max subscription does NOT cover API calls.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: point the openai provider at any OpenAI-compatible endpoint.
# e.g. Groq (free): https://api.groq.com/openai/v1  with OPENAI_API_KEY=gsk_...
# Leave unset to use api.openai.com.
# OPENAI_BASE_URL=

# Only used when LLM_PROVIDER=local (Ollama-compatible endpoint)
LOCAL_LLM_URL=http://localhost:11434

# --- API server ---------------------------------------------------------
# Shared bearer token required on /ask, /search, /ingest, /documents.
# Leave unset to run open (localhost / private network only). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
API_TOKEN=

# Comma-separated browser origins allowed to call the API. "*" allows any
# origin and is safe because every mutating route is token-gated.
CORS_ORIGINS=*

# --- Database ----------------------------------------------------------
# "embedded" (default) boots a project-local PostgreSQL via the `pgserver`
# package into ./.pgdata — no system Postgres / Docker / root needed.
# Set a real postgresql+asyncpg:// URL to use an external database instead.
DATABASE_URL=embedded

# Local embedding model (fastembed). If you change this, also set
# EMBEDDING_DIM to the new model's dimension and re-run ingestion.
# Default is multilingual (Farsi/Persian etc.); for English-only you can use
# BAAI/bge-small-en-v1.5 (384-dim, smaller/faster).
# Offline default (no download; Hugging Face is unreachable from many networks):
# hashed character n-grams. Lexical quality; the FTS half of hybrid retrieval
# carries meaning-free matches. When a real model is reachable, switch to
#   EMBEDDING_MODEL=intfloat/multilingual-e5-large  EMBEDDING_DIM=1024  EMBEDDING_PREFIXES=1
# and run  python -m scripts.reembed
EMBEDDING_MODEL=hash://384
EMBEDDING_DIM=384
EMBEDDING_PREFIXES=0
# Cross-encoder reranker also downloads from Hugging Face — off by default here.
RERANK=0

# --- Entry pipeline (app/rag/workflow.py) -----------------------------
# Fast model for intent routing. Groq is often geo-blocked, so pin a local
# one; a 7B model routes archive-vs-query text reliably, a 3B often does not.
# ROUTER_MODEL=local::qwen2.5:7b
# Wall-clock budget (seconds) for the "similar" step's model tool-loop trail.
# 0 = skip it entirely (the deterministic search is unaffected). ~45 to watch
# the agent try its own search angles.
SIMILAR_TOOL_BUDGET_S=0
# 1 = spend an extra model call on smarter label proposals (~10-25s on a
# local model). Default: keyword match against the taxonomy, no call.
LABELS_LLM=0

# --- v3: tool loop, provenance, similar cases -------------------------
# native = multi-turn tool_result turns on providers that support them
# (anthropic, openai, groq); text = the older "append results as text" loop
# (what local/mock always use). Default: native when the provider can.
TOOL_LOOP=native
# 1 = mark the system prompt + tool list for prompt caching (Anthropic).
PROMPT_CACHE=1
# 1 = route plain questions («query») through the tool-using agent instead of
# the fixed retrieve→answer pipeline. Default 0: the agent is an explicit choice.
AGENT_FOR_QUERY=0
# After a law / cases / query answer, find resembling past cases through the
# case graph (shared articles, parties, court, type) and add a comparative
# advice paragraph. SIMILAR_STAGE_LLM=0 keeps the list but skips the extra
# model call.
SIMILAR_STAGE=1
SIMILAR_STAGE_LLM=1
# Conversation-mode filing («گفتگویی»): how many question/answer rounds the
# assistant may take before committing with whatever it has.
CONVERSATION_MAX_ROUNDS=6

# --- v3: webhooks and live CI --------------------------------------------
# Outbound: subscriptions are created through POST /hooks (each gets its own
# signing secret). Optional comma-separated host allow-list; empty = any host
# (fine for a laptop demo, not for a public deployment).
WEBHOOK_ALLOWED_HOSTS=
# Inbound GitHub webhook (POST /hooks/github): the secret set on the GitHub
# webhook; the receiver is disabled (503) while this is empty.
GITHUB_WEBHOOK_SECRET=
# CI stage reports (POST /ci/status) from scripts/ci_status.sh. Falls back to
# API_TOKEN when empty. In GitHub Actions set the CI_STATUS_URL / CI_STATUS_TOKEN
# repository secrets; the workflow is a no-op without them.
CI_STATUS_TOKEN=

# Live speech-to-text for scripts/live.sh (Gemini Live)
GEMINI_API_KEY=
