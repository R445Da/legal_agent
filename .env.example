# Which LLM backend to use: anthropic | openai | local
LLM_PROVIDER=anthropic

# Optional: override the default model for the chosen provider
# LLM_MODEL=claude-sonnet-4-6

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: point the openai provider at any OpenAI-compatible endpoint.
# e.g. Groq (free): https://api.groq.com/openai/v1  with OPENAI_API_KEY=gsk_...
# Leave unset to use api.openai.com.
# OPENAI_BASE_URL=

# Only used when LLM_PROVIDER=local (Ollama-compatible endpoint)
LOCAL_LLM_URL=http://localhost:11434

# --- API server ---------------------------------------------------------
# Shared bearer token required on /ask, /search, /ingest, /documents.
# Leave unset to run open (localhost / private network only). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
API_TOKEN=

# Comma-separated browser origins allowed to call the API. "*" allows any
# origin and is safe because every mutating route is token-gated.
CORS_ORIGINS=*

# --- Database ----------------------------------------------------------
# "embedded" (default) boots a project-local PostgreSQL via the `pgserver`
# package into ./.pgdata — no system Postgres / Docker / root needed.
# Set a real postgresql+asyncpg:// URL to use an external database instead.
DATABASE_URL=embedded

# Local embedding model (fastembed). If you change this, also set
# EMBEDDING_DIM to the new model's dimension and re-run ingestion.
# Default is multilingual (Farsi/Persian etc.); for English-only you can use
# BAAI/bge-small-en-v1.5 (384-dim, smaller/faster).
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
# e5 models need "query:"/"passage:" prefixes (added automatically). Set to 0
# if you switch to a model that doesn't use them (paraphrase-multilingual-*).
EMBEDDING_PREFIXES=1

# --- Entry pipeline (app/rag/workflow.py) -----------------------------
# Fast model for intent routing. Groq is often geo-blocked, so pin a local
# one; a 7B model routes archive-vs-query text reliably, a 3B often does not.
ROUTER_MODEL=local::qwen2.5:7b
# Wall-clock budget (seconds) for the "similar" step's model tool-loop trail.
# 0 = skip it entirely (the deterministic search is unaffected). ~45 to watch
# the agent try its own search angles.
SIMILAR_TOOL_BUDGET_S=0
# 1 = spend an extra model call on smarter label proposals (~10-25s on a
# local model). Default: keyword match against the taxonomy, no call.
LABELS_LLM=0

# Live speech-to-text for scripts/live.sh (Gemini Live)
GEMINI_API_KEY=
