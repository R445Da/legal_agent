# Copy to .env.docker and fill in. Only GROQ_API_KEY is required; the rest have
# sensible defaults baked into the image and are here so you can tune them
# without rebuilding.

GROQ_API_KEY=gsk_your_key_here

# --- optional overrides ------------------------------------------------------
# LLM_MODEL=openai/gpt-oss-120b        # bigger, slower, better Persian
# ROUTER_MODEL=groq::openai/gpt-oss-20b
# RERANK_TOP=6                         # lower = faster retrieval, some recall lost
# RERANK=0                             # skip the cross-encoder entirely (fastest)
# API_TOKEN=change-me                  # only relevant if you also run the FastAPI API

# Speech to text. Default is Groq's hosted Whisper (needs the key, no download).
# For a fully-local mic set STT_DEFAULT below; the model downloads on first use.
# WHISPER_MODEL=small

# --- fully local chat model (no Groq key, no network) ------------------------
# Bring up the ollama service first:  docker compose --profile local up
# Pre-pull the model:                 docker compose --profile pull up ollama-pull
# Then uncomment all three. LOCAL_LLM_URL is set by compose, don't repeat it.
#
# LLM_PROVIDER=local
# LLM_MODEL=qwen2.5:3b
# ROUTER_MODEL=local::qwen2.5:3b
#
# Note: the archive and analytics intents need strict JSON mode. A 3B model is
# marginal at that — if extraction misbehaves, use a larger tag (qwen2.5:7b).
# Speech-to-text has no local-by-default path either: without GROQ_API_KEY,
# pick a faster-whisper model in the UI (downloads on first use into the
# hfcache volume).
