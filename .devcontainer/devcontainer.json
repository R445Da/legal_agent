{
  "name": "Legal RAG",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",

  // Postgres lives in its own container, exactly as it will in production.
  // `pgserver` (the embedded database used locally) is deliberately unused
  // here: it has no ARM wheel, so developing against a real DATABASE_URL is
  // what keeps this environment honest about the cloud image.
  "remoteEnv": {
    "DATABASE_URL": "postgresql://postgres:postgres@db:5432/postgres",
    "PYTHONPATH": "/workspace"
  },

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        "editor.formatOnSave": false
      }
    }
  },

  "forwardPorts": [8501, 8000],
  "portsAttributes": {
    "8501": { "label": "Streamlit UI", "onAutoForward": "openPreview" },
    "8000": { "label": "Run console",  "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteUser": "vscode"
}
